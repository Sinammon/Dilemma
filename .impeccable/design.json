  "narrative": {
    "northStar": "The Purple Component Playground",
    "overview": "Dilemma adapts the user-supplied Uizard reference into a dark purple system for Canadian car comparison. Clear blue actions and geometric display type establish the identity; solid surfaces and legible evidence support sustained reading. The reference is inspiration, not a copied product identity.\n\nThe system uses tonal layering and thin boundaries rather than shadows. Car photographs remain uncropped against neutral mats, while labels distinguish facts, sources, warnings and uncertainty. The photo-credit page carries the same palette and self-hosted typefaces in a narrower reading layout.",
    "keyCharacteristics": [
      "Purple tonal surfaces with one blue action hierarchy.",
      "Clash Grotesk headings with Satoshi interface text.",
      "Readable source labels, status text and tabular vehicle values.",
      "Contained car photography and manual preview interactions."
    ],
    "rules": [
      {
        "name": "The Dark Ink Rule",
        "body": "Bright blue action and selected-state fills use dark ink, never white button text.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "State is expressed in words as well as color; source provenance and unresolved values remain readable.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Clash Grotesk carries headings; Satoshi carries controls, prose, labels and vehicle values.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Resting surfaces use solid color and thin borders, without drop shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the named color and type roles across all screens.",
      "Do keep car photographs contained and source labels close to their facts.",
      "Do preserve keyboard focus, reduced motion and explicit state wording.",
      "Do treat comparison-table scrolling as local, not permission for page overflow."
    ],
    "donts": [
      "Don't replace dark ink with white on blue action fills.",
      "Don't turn absent specifications into visual certainty or remove visible warnings.",
      "Don't crop vehicle photographs to fill a frame.",
      "Don't introduce autoplay, decorative eyebrow labels or invented proof."
    ]
  }
}
